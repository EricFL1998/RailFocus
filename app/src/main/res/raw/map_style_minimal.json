{
    "version": 8,
    "name": "Rail Focus Minimal",
    "metadata": {
        "mapbox:autocomposite": false,
        "mapbox:type": "default"
    },
    "sources": {
        "openmaptiles": {
            "type": "vector",
            "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=get_your_own_key"
        }
    },
    "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=get_your_own_key",
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#E8F5E9"
            }
        },
        {
            "id": "landcover",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landcover",
            "paint": {
                "fill-color": "#C8E6C9",
                "fill-opacity": 0.8
            }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "water",
            "paint": {
                "fill-color": "#B3E5FC",
                "fill-opacity": 1.0
            }
        },
        {
            "id": "park",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "park",
            "paint": {
                "fill-color": "#A5D6A7",
                "fill-opacity": 0.6
            }
        },
        {
            "id": "road-secondary",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": ["all", ["in", "class", "secondary", "tertiary"]],
            "paint": {
                "line-color": "#81C784",
                "line-width": 2
            }
        },
        {
            "id": "road-primary",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": ["all", ["in", "class", "primary", "motorway", "trunk"]],
            "paint": {
                "line-color": "#66BB6A",
                "line-width": 3
            }
        },
        {
            "id": "rail",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": ["all", ["in", "class", "rail"]],
            "paint": {
                "line-color": "#2E7D32",
                "line-width": 2,
                "line-dasharray": [2, 4]
            }
        },
        {
            "id": "building",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "building",
            "paint": {
                "fill-color": "#E0E0E0",
                "fill-opacity": 0.5
            }
        },
        {
            "id": "text-city",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "place",
            "filter": ["==", "class", "city"],
            "layout": {
                "text-field": "{name:zh}",
                "text-size": 14,
                "text-font": ["Noto Sans Regular"]
            },
            "paint": {
                "text-color": "#424242",
                "text-halo-color": "#FFFFFF",
                "text-halo-width": 1.5
            }
        },
        {
            "id": "text-town",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "place",
            "filter": ["==", "class", "town"],
            "layout": {
                "text-field": "{name:zh}",
                "text-size": 11,
                "text-font": ["Noto Sans Regular"]
            },
            "paint": {
                "text-color": "#616161",
                "text-halo-color": "#FFFFFF",
                "text-halo-width": 1
            }
        },
        {
            "id": "text-station",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "poi",
            "filter": ["==", "class", "railway"],
            "layout": {
                "text-field": "{name:zh}",
                "text-size": 12,
                "text-font": ["Noto Sans Medium"],
                "icon-image": "rail-15",
                "icon-size": 1.2,
                "text-offset": [0, 1.2],
                "text-anchor": "top"
            },
            "paint": {
                "text-color": "#1B5E20",
                "text-halo-color": "#FFFFFF",
                "text-halo-width": 1.5
            }
        }
    ]
}
