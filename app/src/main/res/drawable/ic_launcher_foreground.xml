    <!-- Material 3 Native Google Style HSR Icon -->
    <!-- Composition: Centered and scaled to fit the "Safe Zone" (approx 66dp inner circle).
         This ensures the icon is NOT cut off even on square/squircle shapes,
         while keeping the nose as the focal point. -->
